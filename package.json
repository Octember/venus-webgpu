{
  "name": "venus-webgpu",
  "version": "0.1.0",
  "description": "Venus (virtio-gpu Vulkan) to WebGPU bridge for browser Linux",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "vulkan",
    "venus",
    "virtio-gpu",
    "webgpu",
    "spirv",
    "wgsl",
    "unkernel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noahbuiltit/venus-webgpu.git"
  },
  "homepage": "https://github.com/noahbuiltit/venus-webgpu#readme",
  "bugs": {
    "url": "https://github.com/noahbuiltit/venus-webgpu/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./unkernel": {
      "types": "./dist/transport/unkernel.d.ts",
      "default": "./dist/transport/unkernel.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "dev": "bun run demo",
    "demo": "bun run demo/serve.ts",
    "check": "bun run typecheck && bun test && bun run build",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "naga-wasm": "^30.2.0"
  },
  "peerDependencies": {
    "@webgpu/types": ">=0.1.40"
  },
  "peerDependenciesMeta": {
    "@webgpu/types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.51",
    "typescript": "^5.7.0"
  }
}
